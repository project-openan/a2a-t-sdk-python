      "outcome": "failure",
      "exception": "NegotiationParamExtractionException",
      "code": "llm.invocation_failed",
      "messageContains": ["LLM 调用失败"],
      "slotErrors": [ { "slot": "_llm", "code": "llm.invocation_failed" } ],
