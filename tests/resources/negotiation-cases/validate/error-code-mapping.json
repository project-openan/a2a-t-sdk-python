[
  {
    "id": "VAL-MAP-01",
    "api": "validateProposePromptAndDataFilling",
    "languages": ["zh-CN"],
    "priority": "P0",
    "tags": ["error-code-mapping", "map-code", "null-context", "invalid-input"],
    "summary": "消息未携带协商上下文元数据时校验判定其不是协商消息，按非协商消息拒绝并返回协商无效输入错误码且不发起任何大模型调用",
    "context": null,
    "templateUri": "Negotiation-T/information-negotiation/propose/v1",
    "prompt": { "golden": "information_propose" },
    "schema": { "$ref": "schemas/biz.complaint.params" },
    "llm": { "script": [ { "$fail": "assertion" } ] },
    "expect": {
      "outcome": "failure",
      "exception": "NegotiationParamExtractionException",
      "code": "negotiation.invalid_input",
      "messageContains": ["缺少协商上下文"],
      "llmCalls": 0
    }
  },
  {
    "id": "VAL-MAP-02",
    "api": "validateProposePromptAndDataFilling",
    "languages": ["zh-CN"],
    "priority": "P0",
    "tags": ["error-code-mapping", "map-code", "rule-violation", "round"],
