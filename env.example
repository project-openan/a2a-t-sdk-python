# A2A-T SDK environment template (corresponds to Java a2a-t-sdk 1.1.0 capability surface).
# Copy to .env next to your entry point (the SDK reads a .env file, not OS environment variables).

# Prompt runtime
# Controls the language used by prompt runtime components.
A2AT_LANGUAGE=en-US
# Selects the prompt source backend (packaged | local_file); packaged is the default since 1.1.0.
# Set local_file to restore the pre-1.1.0 behavior and read business content from a directory.
A2AT_PROMPT_SOURCE_TYPE=packaged
# Optional local root for custom scenarios, slots, and templates; only used when
# A2AT_PROMPT_SOURCE_TYPE=local_file (fail-fast when unset or the path does not exist).
# templates/, slots/, scenarios/, and negotiation-vocabulary/ are read from this root;
# LLM instruction prompts and error messages are always loaded from the installed package.
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
# Enables or disables prompt compliance checks.
A2AT_PROMPT_COMPLIANCE_ENABLED=false

# Input limits
# Maximum length in characters accepted for free-text inputs (from-text generation and
# prompt validation entry points) before they reach an LLM step; oversized inputs fail fast
# with the error code input.text_too_long instead of overflowing the LLM context.
A2AT_INPUT_TEXT_MAX_CHARS=16384

# LLM runtime
# Selects the LLM provider used by the shared client.
A2AT_LLM_PROVIDER=
# Selects the default model name for the configured provider.
A2AT_LLM_MODEL=
# API key for the configured LLM provider.
A2AT_LLM_API_KEY=
# Base URL for the configured LLM provider.
A2AT_LLM_BASE_URL=
# Optional maximum tokens for completion calls.
A2AT_LLM_MAX_TOKENS=2000
# Default sampling temperature.
A2AT_LLM_TEMPERATURE=0
# Request timeout in seconds.
A2AT_LLM_TIMEOUT_SECONDS=60
# Number of chat history messages to keep.
A2AT_LLM_HISTORY_WINDOW=10
# Reasoning effort level (none, minimal, low, medium, high, xhigh). Set to empty to skip.
A2AT_LLM_REASONING_EFFORT=
# Whether to verify the TLS certificate chain and hostname of the LLM endpoint. Set to false
# only short-term in controlled environments when the HTTPS LLM gateway presents a certificate
# that is not trusted; prefer importing a trusted CA instead.
A2AT_LLM_SSL_VERIFY=true
# Maximum total number of tracked sessions.
A2AT_LLM_SESSION_MAX_TOTAL=300
# Maximum number of tracked sessions per provider.
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100
# Maximum number of attempts for retryable LLM steps (range 1-10, default 3).
A2AT_LLM_MAX_ATTEMPTS=3
# Whether to print the full LLM request and response payloads (no truncation). Defaults to
# false. WARNING: enabling this prints detailed LLM interaction content, which may expose
# sensitive information and consume large amounts of log space; use ONLY during project
# debugging and keep it disabled in production.
# Summary logs (timestamp, token usage, elapsed time) are recorded at DEBUG level whenever
# the dedicated logger a2a_t.llm.call is enabled for DEBUG; where the lines are printed is
# decided by the embedding application's logging framework.
A2AT_LLM_DETAIL_LOG_ENABLED=false

# Negotiation
# Selects the negotiation state store implementation (legacy state-machine demo, deprecated).
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory

# Live-LLM corpus tests (dev only; fully decoupled from the production A2AT_LLM_* keys)
# Base URL of the live endpoint used by the live corpus family; the family skips when unset.
A2AT_TEST_LLM_BASE_URL=
# API key of the live endpoint used by the live corpus family.
A2AT_TEST_LLM_API_KEY=
# Model name used by the live corpus family.
A2AT_TEST_LLM_MODEL=
# Optional sampling temperature of the live corpus calls.
A2AT_TEST_LLM_TEMPERATURE=
# Optional request timeout in seconds of the live corpus calls.
A2AT_TEST_LLM_TIMEOUT_SECONDS=
