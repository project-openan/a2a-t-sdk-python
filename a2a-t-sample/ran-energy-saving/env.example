# Unified configuration of the RAN energy-saving ADK sample.
#
# Precedence: CLI arguments > shell environment > per-run .env > this file > defaults.
# Any exported A2AT_*/ADK_*/LANGFUSE_*/REGISTRY_*/OTEL_* key overrides this file.
#
# Copy this file to `a2a-t-sample/ran-energy-saving/.env` (or `a2a-t-sample/.env`) and adjust it.
# The defaults below are a complete offline profile: `offline` runs the scripted SDK LLM provider
# plus the deterministic ADK fake model, so no API key and no network access are needed.
# Every key is read by `shared/config.py`, `run_demo.py`, or the A2A-T SDK itself.

# --- Model mode ---------------------------------------------------------------------------
# `offline`: scripted SDK provider + deterministic ADK fake model (default, no key needed).
# `live`:    the OpenAI-compatible endpoint below is used by both the SDK and the ADK agent.
A2AT_SAMPLE_MODEL_MODE=offline

# --- Process-level language ---------------------------------------------------------------
# `en-US` or `zh-CN`. `run_demo.py --language` writes the same value into registry, server and
# client. The language is not switchable per run and the Web UI only displays it.
A2AT_LANGUAGE=en-US

# --- A2A server bind ----------------------------------------------------------------------
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8000

# --- Mock registry center -----------------------------------------------------------------
# The server registers its AgentCard here and the client discovers it from here.
REGISTRY_CENTER_HOST=127.0.0.1
REGISTRY_CENTER_PORT=5001

# --- Service discovery --------------------------------------------------------------------
# `registry`: query the registry center above.
# `direct`:   read `<A2AT_SAMPLE_DIRECT_SERVER_URL>/.well-known/agent-card.json`.
# `nms`:      connect to a vendor NMS that publishes no AgentCard; requires the NMS block below.
A2AT_SAMPLE_DISCOVERY=registry
A2AT_SAMPLE_DIRECT_SERVER_URL=http://127.0.0.1:8000

# --- Operator intent layer ----------------------------------------------------------------
# `processed`: run the business intent layer before the A2A/A2A-T mapping (default).
# `raw`:       send the operator text directly (pre-intent-layer behavior).
# `--intent-mode` and `POST /api/runs.intentMode` override this per run.
A2AT_SAMPLE_INTENT_MODE=processed

# --- Client-side Task-T validation --------------------------------------------------------
# `on`:     validate the rendered Task-T before sending, for the presentation page only.
# `always`: validate on every entry point (tester, Explorer, CLI, gateway).
# `off`:    disable the pre-send gate.
# Blocking errors end the run with `input_invalid` and nothing is sent; errors that map to a
# server negotiation kind still go out, so the negotiation demo keeps working.
A2AT_SAMPLE_PRE_SEND_VALIDATION=on

# --- Run isolation (two instances on one machine) -----------------------------------------
# `A2AT_SAMPLE_RUN_DIR` owns launcher state: pids.json, child logs and the per-run .env.
# `A2AT_SAMPLE_RUNS_DIR` owns data: transcripts, sqlite stores, NMS wire logs and UI history.
# Set both to different values for the second instance; `--stop` then only stops its own pids.
# A2AT_SAMPLE_RUN_DIR=%TEMP%/a2at-ran-energy-saving-adk
# A2AT_SAMPLE_RUNS_DIR=runs
# Pure A2A follow-up fields: `both` (default), `task` or `context`. Switch to `context` when the
# vendor rejects a follow-up message carrying `taskId`.
A2AT_SAMPLE_PURE_FOLLOWUP=both

# --- Vendor NMS (A2AT_SAMPLE_DISCOVERY=nms) -----------------------------------------------
# `run_demo.py --nms` writes DISCOVERY=nms into the per-run .env and starts no local registry,
# RAN server or MIE. A2A-T talks to the NMS directly; `--nms --protocol a2a` keeps the local OSS
# Agent (engineer UI -> OSS Agent -> NMS) and starts no RAN Agent. Fill these values in the .env
# used by the run; never commit credentials.
#
# Only the host is required. The sample derives both standard URLs from it:
#   A2A   = <scheme>://<host>:31127/a2a/json
#   token = <scheme>://<host>:27417/rest/plat/smapp/v1/sessions
A2AT_SAMPLE_NMS_HOST=<nms-host>
A2AT_SAMPLE_NMS_TOKEN_USER=<northbound-user>
A2AT_SAMPLE_NMS_TOKEN_VALUE=<password>
#
# Optional overrides for a non-standard deployment. The explicit full URLs win when set.
# A2AT_SAMPLE_NMS_SCHEME=https
# A2AT_SAMPLE_NMS_A2A_PORT=31127
# A2AT_SAMPLE_NMS_TOKEN_PORT=27417
# A2AT_SAMPLE_NMS_A2A_BASE=https://<nms-host>:31127/a2a/json
# A2AT_SAMPLE_NMS_TOKEN_URL=https://<nms-host>:27417/rest/plat/smapp/v1/sessions
#
# The region and sites the vendor NMS serves. In NMS mode they are used only to prefill the
# visible example request and to configure the local simulator; they never overwrite a value the
# operator typed. There is no built-in default: a real-NMS run must set the region explicitly
# (for example A2ATestRegion on the 910 test environment). The launcher pins both values for
# --nms-sim automatically.
# A2AT_SAMPLE_NMS_REGION=A2ATestRegion
# A2AT_SAMPLE_NMS_SITES=NRES_XCS_6102937,LTE_26441_LNR_OCL
# Continue reading a negotiation-response stream for the next PROPOSE. The vendor opens a new
# negotiation id on the same context id after ACCEPT; turn off only if the vendor changes that.
A2AT_SAMPLE_NMS_READ_AFTER_SEND=1
# Type a real-NMS PROPOSE that carries no templateUri from the opening heading of its body
# (## Information Negotiation / ## 信息协商, ...). The vendor omits the field on the proposal that
# continues a negotiation; a body with no known heading still fails instead of guessing.
A2AT_SAMPLE_NMS_INFER_NEGOTIATION_KIND=1
# Write the raw exchange to runs/<runId>/wire.jsonl (credentials redacted). Default true in NMS
# mode; set 0 to keep business payloads off disk.
A2AT_SAMPLE_NMS_WIRE_LOG=1
#
# The 910 test environment uses a self-signed certificate: keep false for tests, set true only
# when the certificate chain is trusted.
A2AT_SAMPLE_NMS_VERIFY_TLS=false
# A data: frame gap this long means the stream is idle and the client switches to task polling.
# The vendor NMS can take over a minute to send its first push; shorter windows downgrade early.
A2AT_SAMPLE_NMS_IDLE_TIMEOUT_SECONDS=120
# Budget of one NMS request (token, send, task poll).
A2AT_SAMPLE_NMS_REQUEST_TIMEOUT_SECONDS=120

# Local NMS simulator only: keep a newly created Task WORKING so the presentation's
# "Running tasks" picker has a target. The creating run ends as `incomplete`;
# a later Modify on that Task completes normally.
# A2AT_SAMPLE_NMS_SIM_HOLD_WORKING=1

# Local NMS simulator only: reproduce the vendor's older cancel defect, where
# `POST /tasks/{id}:cancel` always answers HTTP 503. Leave unset for the normal path,
# which moves the Task to TASK_STATE_CANCELED.
# A2AT_SAMPLE_NMS_SIM_CANCEL_UNSUPPORTED=1

# --- Client event transport ---------------------------------------------------------------
# `sse`: stream `message:stream` responses (default).
# `webhook`: non-blocking send plus the client's embedded push receiver below.
A2AT_SAMPLE_TRANSPORT=sse

# Webhook receiver (used when A2AT_SAMPLE_TRANSPORT=webhook; required by a real `--nms` run).
# `--nms` defaults to webhook + `message:send`; the local NMS simulator stays on SSE.
# Use an address the vendor NMS can reach (not 127.0.0.1) for real integration.
A2AT_SAMPLE_WEBHOOK_HOST=127.0.0.1
# Port `0` selects an ephemeral port.
A2AT_SAMPLE_WEBHOOK_PORT=9000
# Static demo token; the a2a-sdk push sender sends it in the X-A2A-Notification-Token header.
# When A2AT_SAMPLE_WEBHOOK_AUTH_CREDENTIALS is set, the receiver checks Basic auth instead (the
# vendor NMS sends no push token).
A2AT_SAMPLE_WEBHOOK_TOKEN=demo-webhook-token
# Backstop: end a webhook phase when no push arrives for this many seconds. It follows the client
# HTTP budget so a webhook phase cannot end before the client gives up (default 300 = HTTP budget).
A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=300

# --- Real-NMS webhook callback (https + Basic auth) ---------------------------------------
# URL registered in the task push config instead of the bind address. The vendor NMS requires
# https and reaches the client through a gateway address, so use `https://<gateway>:<port>/webhook`.
# Must match the reachable address; 127.0.0.1 is only valid for the local simulator.
A2AT_SAMPLE_WEBHOOK_PUBLIC_URL=
# PEM certificate and matching private key of the receiver's TLS listener (relative paths resolve
# against this sample directory when the launcher writes the per-run .env). Both set -> the
# listener serves https; empty -> plain http.
A2AT_SAMPLE_WEBHOOK_TLS_CERT=
A2AT_SAMPLE_WEBHOOK_TLS_KEY=
# `user:password` registered as the push config's Basic authentication, and the only credentials
# the receiver accepts while it is set (the vendor sends no push token). Empty -> the receiver
# falls back to A2AT_SAMPLE_WEBHOOK_TOKEN. Keep it only in .env (gitignored); never commit it.
A2AT_SAMPLE_WEBHOOK_AUTH_CREDENTIALS=

# --- Timeout budgets (live fail-fast) -----------------------------------------------------
# Client HTTP budget of one A2A request. A live-mode server gate performs several SDK LLM calls
# before it sends any event, so the client must wait longer than the server's worst case. The
# default 300s covers the 120s per-call budget across a gate plus ADK agent turns.
A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300
# Live LLM budget of one call (SDK structured call or ADK LiteLlm turn) and the SDK's protocol
# retry limit (1..10). The sample writes both values into the per-run SDK .env (overriding
# A2AT_LLM_TIMEOUT_SECONDS / A2AT_LLM_MAX_ATTEMPTS below). The OpenAI transport retries are
# disabled by the traced provider, so one call cannot silently become three attempts; raise the
# timeout further for slower endpoints rather than relying on hidden retries.
A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120
A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1
# Migration: existing .env files that set A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=30 or
# A2AT_LLM_TIMEOUT_SECONDS=60 should be updated or removed; the new sample keys are
# A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300, A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120 and
# A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1.

# --- Web UI -------------------------------------------------------------------------------
# Default bind host/port of the client Web UI (`run_demo.py --ui`); `--ui-host` / `--ui-port`
# override them. Use 0.0.0.0 to expose the UI on all interfaces (trusted networks only: the demo
# UI has no authentication).
A2AT_SAMPLE_UI_HOST=127.0.0.1
A2AT_SAMPLE_UI_PORT=8080
# Presentation brand: `orange` (reference demo, default) or `huawei`. The page can switch at runtime;
# `--brand` overrides this value and `?brand=huawei` overrides both for one browser session.
A2AT_SAMPLE_UI_BRAND=orange

# --- Run Explorer trace transport (local demo only) ---------------------------------------
# `run_demo.py --ui` sets both keys for the server process automatically: the server POSTs trace
# spans to the Web UI, which accepts them only with the matching per-run token. With neither key
# set (the CLI case) the server writes runs/<runId>/server-trace.jsonl under A2AT_SAMPLE_TRACE_DIR.
# Keep this transport on localhost only: spans carry model prompts, tool arguments and results.
# A2AT_SAMPLE_TRACE_URL=http://127.0.0.1:8080
# A2AT_SAMPLE_TRACE_TOKEN=<random-local-token>
# A2AT_SAMPLE_TRACE_DIR=runs

# --- NMS task persistence -----------------------------------------------------------------
# Absolute SQLite path of the server's A2A Task store. `run_demo.py` overwrites this with
# <sample>/runs/task-status.sqlite3, so the Web UI can show the persisted task table. Unset keeps
# the in-memory store (tests and ephemeral direct runs).
# A2AT_SAMPLE_TASK_DB=/absolute/path/to/task-status.sqlite3

# Absolute SQLite path of the OSS Agent's A2A Task store and its downstream bindings. `run_demo.py`
# writes <sample>/runs/oss-task-status.sqlite3. Unset keeps the OSS Task state in memory (tests and
# ephemeral runs).
# A2AT_SAMPLE_OSS_TASK_DB=/absolute/path/to/oss-task-status.sqlite3

# Long-running OSS task tracking. `auto` enables it for the real NMS webhook hop when the OSS Task
# database is configured; `on`/`off` force it. The settle window only ends the synchronous stream:
# the run and the outer Task keep tracking in the background, and the NMS Task is never cancelled.
# A2AT_SAMPLE_LONG_TASK_MODE=auto
# A2AT_SAMPLE_LONG_TASK_SETTLE_SECONDS=5
# Terminal downstream bindings are kept this many days before the OSS startup cleanup removes
# them (default 7).
# A2AT_SAMPLE_TASK_RETENTION_DAYS=7
# How often the Web UI polls a remote Task that is still executing (seconds).
# A2AT_SAMPLE_TASK_POLL_INTERVAL_SECONDS=30
# Seconds without an NMS status event before the direct NMS transport hands a non-terminal Task
# to the run manager's background tracker. The tracker keeps the run active; it stops after 30s
# without a page subscription and records the run as incomplete (the NMS Task is not touched).
# A2AT_SAMPLE_NMS_POLL_AFTER_SECONDS=15
# Faster tracker poll interval while the engineer page is still subscribed (seconds).
# A2AT_SAMPLE_NMS_STATE_POLL_SECONDS=5

# --- Client persistence -------------------------------------------------------------------
# Absolute SQLite path of the client state (conversations, turns, runs, negotiation audit, task
# snapshots and the ADK decision-agent sessions). This is a second database: the client and the RAN
# server are two systems. `run_demo.py` writes <sample>/runs/client-state.sqlite3. Unset keeps the
# client state in memory. Decision-agent sessions are kept as audit data for the retention below.
# A2AT_SAMPLE_CLIENT_DB=/absolute/path/to/client-state.sqlite3
# Days a decision-agent session (prompts, answers, tool results) is kept before the startup and
# hourly sweeps remove it. Minimum 1.
A2AT_SAMPLE_ADK_SESSION_RETENTION_DAYS=7
# Number of recent conversation turns injected into the next run's prompts (0 disables memory).
A2AT_SAMPLE_CLIENT_MEMORY_TURNS=6

# --- Authentication -------------------------------------------------------------------------
# Bearer token required by the Web UI /api routes and the inbound gateway A2A routes.
# Empty keeps them open and only allows a loopback bind; binding a non-loopback address
# without a token fails at startup.
# A2AT_SAMPLE_AUTH_TOKEN=
# Service token of the A2A server: the client sends it as `Authorization: Bearer ...` and the
# server requires it on every route except the AgentCard and health endpoints. Empty keeps the
# server open and only allows a loopback bind. `run_demo.py` copies the key from the source
# `.env` to both processes, so they agree.
# A2AT_SAMPLE_SERVER_AUTH_TOKEN=

# --- Inbound A2A gateway (optional, Gemini Enterprise path) -------------------------------
# The client agent can also act as a backend A2A agent: one inbound message runs one client flow
# and returns the final report. `run_demo.py --gateway` starts it; it is off by default.
A2AT_SAMPLE_GATEWAY_HOST=127.0.0.1
A2AT_SAMPLE_GATEWAY_PORT=8001
A2AT_SAMPLE_GATEWAY_REGISTER=0
A2AT_SAMPLE_GATEWAY_SCENARIO=information
# Absolute SQLite path of the inbound gateway's A2A Task store. The same file holds the push
# notification registrations of external callers (schema version 2). Unset keeps inbound Tasks and
# registrations in memory. `run_demo.py` writes <sample>/runs/gateway-task-status.sqlite3.
# A2AT_SAMPLE_GATEWAY_TASK_DB=/absolute/path/to/gateway-task-status.sqlite3

# --- Standard A2A / A2A-T in one agent (`--protocol both`) ---------------------------------
# Server mode: `a2a-t`, `a2a`, or `both`. `both` serves the A2A-T extension and the standard A2A
# Task lifecycle in one process, deciding per request from the Task-T declaration/metadata.
A2AT_SAMPLE_PROTOCOL_MODE=a2a-t
# In `both` mode the standard A2A request keeps its MIE review while the A2A-T server gate stays
# off unless `A2AT_SAMPLE_APPROVAL_GATE=1`. Set 0 to disable the MIE review too.
# A2AT_SAMPLE_PURE_APPROVAL_GATE=1
# One approval waits this long before it times out (default: one day).
# A2AT_SAMPLE_APPROVAL_TIMEOUT_SECONDS=86400
# The launcher writes these values into its per-run `.env`; set them only when starting a process
# by hand. The engineer client discovers the OSS card directly (A2AT_SAMPLE_DIRECT_SERVER_URL),
# the OSS discovers RAN, and RAN discovers MIE.
# With `--protocol both --nms`, the UI and the OSS process each keep a callback receiver: the OSS
# takes A2AT_SAMPLE_WEBHOOK_PORT + 1 by default. Set A2AT_SAMPLE_OSS_WEBHOOK_PORT when that would
# collide with another instance. A2AT_SAMPLE_OSS_WEBHOOK_PUBLIC_URL is required for a real NMS run
# (it is never inherited from the UI callback) and must be an https address reachable from the NMS.
# The public URL port must equal the receiver port; a gateway/NAT that maps a different external
# port requires A2AT_SAMPLE_ALLOW_CALLBACK_PORT_MISMATCH=1.
# A2AT_SAMPLE_OSS_WEBHOOK_PORT=9001
# A2AT_SAMPLE_OSS_WEBHOOK_PUBLIC_URL=
# A2AT_SAMPLE_ALLOW_CALLBACK_PORT_MISMATCH=0
A2AT_SAMPLE_OSS_HOST=127.0.0.1
A2AT_SAMPLE_OSS_PORT=8001
A2AT_SAMPLE_MIE_HOST=127.0.0.1
A2AT_SAMPLE_MIE_PORT=8002
A2AT_SAMPLE_RAN_URL=http://127.0.0.1:8000
A2AT_SAMPLE_MIE_URL=http://127.0.0.1:8002

# --- LangGraph planner (server side, live mode) -------------------------------------------
# The server executes an accepted Task with a LangGraph ReAct planner. Offline mode uses the
# deterministic scripted model. In live mode these keys default to the ADK endpoint/model above
# when unset; set them to point the server planner at a different model.
# A2AT_SAMPLE_PLANNER_MODEL=mass/volcengine/deepseek-v4.1-flash
# A2AT_SAMPLE_PLANNER_API_BASE=http://127.0.0.1:31943/v1
# A2AT_SAMPLE_PLANNER_API_KEY=not-needed
A2AT_SAMPLE_PLANNER_TIMEOUT_SECONDS=120
A2AT_SAMPLE_PLANNER_MAX_STEPS=12

# --- ADK agent model (client only, live mode) ---------------------------------------------
# LiteLlm needs the provider prefix in the model id. The `mass/` prefix is the model id exposed
# by the local OpenAI-compatible proxy; use whatever id your endpoint advertises.
ADK_MODEL_PROVIDER=litellm
ADK_MODEL_NAME=openai/mass/volcengine/deepseek-v4.1-flash
ADK_MODEL_API_BASE=http://127.0.0.1:31943/v1
ADK_MODEL_API_KEY=not-needed
# Whether ADK may send the client agent's output_schema (response_format) together with its tools.
# `auto` keeps ADK's provider detection. Qwen-compatible endpoints reject that combination, so set
# `false`: ADK then exposes the schema through the synthetic `set_model_response` tool and the model
# keeps its normal tool loop.
ADK_MODEL_OUTPUT_SCHEMA_WITH_TOOLS=auto

# --- A2A-T SDK LLM (live mode) ------------------------------------------------------------
# The SDK reads its configuration from the .env file passed to A2ATClient / A2ATServer.
# Offline runs override these with the `scripted` provider; in live mode they must point at the
# same OpenAI-compatible endpoint as the ADK model so both sides behave consistently.
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=mass/volcengine/deepseek-v4.1-flash
A2AT_LLM_API_KEY=not-needed
A2AT_LLM_BASE_URL=http://127.0.0.1:31943/v1
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
# Source value only: the sample overrides it with A2AT_SAMPLE_LLM_TIMEOUT_SECONDS (120s) and
# A2AT_SAMPLE_LLM_MAX_ATTEMPTS (1) in the per-run SDK .env.
A2AT_LLM_TIMEOUT_SECONDS=60

# Print full LLM request/response payloads (debug only; may expose sensitive content).
A2AT_LLM_DETAIL_LOG_ENABLED=false

# --- Langfuse client observability (live mode only) ----------------------------------------
# Export one client trace per run: intent, approval, Task-T, negotiation rounds, decisions,
# LLM generations and tools. The export is best effort and never changes the protocol flow.
# Enable it by setting both keys; `A2AT_SAMPLE_LANGFUSE_ENABLED=0` forces it off.
# Credentials are secrets: never commit real values.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# SDK/API endpoint. In a restricted network this may be a reporting proxy.
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Browser-facing UI base used only for the "Open in Langfuse" link. It defaults to Langfuse Cloud,
# so a proxy in LANGFUSE_BASE_URL does not leak into the link. Set it to the address the browser
# can actually open (self-hosted UI or a UI relay).
A2AT_SAMPLE_LANGFUSE_UI_BASE_URL=https://us.cloud.langfuse.com
# A2AT_SAMPLE_LANGFUSE_ENABLED=
# `1` sends prompt/response text; `0` sends only model, token, status and timing metadata.
A2AT_SAMPLE_LANGFUSE_CAPTURE_CONTENT=1
A2AT_SAMPLE_LANGFUSE_ENVIRONMENT=demo
# Langfuse export detail. `phase` (default) keeps LLM/tool spans, the run result and the OSP
# time-point carriers (every hop/round message_sent, propose and decision, Task-T rendered, Task
# created, the business intent, the validation verdict, the approval pair); `minimal` keeps only
# LLM/tool spans and the run result (about a third of the old volume); `full` exports every Run
# Explorer span, including `transport` NMS wire evidence. The Web UI timeline always keeps every
# span.
A2AT_SAMPLE_TRACE_SPAN_LEVEL=phase
# Server-side SDK spans (`SendMessage` / `CancelTask`) join the client trace through the W3C
# traceparent the sample injects on local A2A calls. To make them visible in Langfuse, point the
# SDK's OTLP exporter at the same project. The a2a-t SDK reads these from the process environment;
# run_demo exports them from the selected .env file. AUTH_STRING is base64(public_key:secret_key).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <AUTH_STRING>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=ran-energy-saving-server
# Level: DEBUG / INFO / WARNING / ERROR / CRITICAL.
A2AT_SAMPLE_LOG_LEVEL=INFO
# Format: `text` for a terminal, `json` for a log collector (one object per line).
A2AT_SAMPLE_LOG_FORMAT=text
