# RAN energy-saving sample — live profile for real-NMS integration.
#
# Copy this file to `.env` and fill the model and NMS endpoints. The sample is live-only:
# every decision and every Task-T is produced by the configured OpenAI-compatible model.
#
# Precedence: CLI arguments > shell environment > per-run .env > this file > defaults.
# Any exported A2AT_*/ADK_*/LANGFUSE_*/OTEL_* key overrides this file.

# --- Model endpoint (required) ------------------------------------------------------------
# ADK agent turns (client decision, intent, server planner) use this endpoint.
ADK_MODEL_PROVIDER=litellm
ADK_MODEL_NAME=openai/<your-provider>/<your-model>
ADK_MODEL_API_BASE=http://127.0.0.1:31943/v1
ADK_MODEL_API_KEY=<required>

# The SDK structured calls (Task-T slot extraction and validation) use the same endpoint.
# Leave these blank to derive them from the ADK_* values above.
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=
A2AT_LLM_TIMEOUT_SECONDS=180
A2AT_LLM_MAX_ATTEMPTS=1

# --- Process language ---------------------------------------------------------------------
A2AT_LANGUAGE=en-US

# --- Local reference RAN server (optional) ------------------------------------------------
# Only needed when the local `protocol.server_app` is used as a reference server.
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8000
A2AT_SAMPLE_PROTOCOL_MODE=both

# --- Service discovery and transport ------------------------------------------------------
# `direct` reads /.well-known/agent-card.json from the local server; `nms` calls the vendor.
A2AT_SAMPLE_DISCOVERY=direct
A2AT_SAMPLE_DIRECT_SERVER_URL=http://127.0.0.1:8000
# `sse` for the local demo; a real `--nms` run requires `webhook`.
A2AT_SAMPLE_TRANSPORT=sse

# --- Callback receiver (real NMS runs) ----------------------------------------------------
A2AT_SAMPLE_WEBHOOK_HOST=127.0.0.1
A2AT_SAMPLE_WEBHOOK_PORT=9000
# Public URL the NMS uses to reach this receiver; required when the bind address is not
# reachable from the vendor network.
# A2AT_SAMPLE_WEBHOOK_PUBLIC_URL=https://ran-client.example:9000/webhook
A2AT_SAMPLE_WEBHOOK_TOKEN=<callback-token>
A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=120

# --- Vendor NMS (required for --nms) ------------------------------------------------------
# Fill the A2A surface and the token endpoint of the customer NMS.
A2AT_SAMPLE_NMS_A2A_BASE=https://<nms-host>:31127/a2a/json
A2AT_SAMPLE_NMS_TOKEN_URL=https://<nms-host>:27417/rest/plat/smav1/sessions
A2AT_SAMPLE_NMS_TOKEN_USER=<northbound-user>
A2AT_SAMPLE_NMS_TOKEN_VALUE=<password>
A2AT_SAMPLE_NMS_VERIFY_TLS=false
A2AT_SAMPLE_NMS_REGION=<served-region>
A2AT_SAMPLE_NMS_SITES=<site-a>,<site-b>
A2AT_SAMPLE_NMS_WIRE_LOG=1

# --- Long-running Tasks -------------------------------------------------------------------
# Required for a real NMS: the run keeps tracking the remote Task after the observation window.
A2AT_SAMPLE_LONG_TASK_TRACKING=1
A2AT_SAMPLE_TASK_POLL_INTERVAL_SECONDS=120
A2AT_SAMPLE_NMS_POLL_AFTER_SECONDS=120
A2AT_SAMPLE_NMS_STATE_POLL_INTERVAL_SECONDS=15

# --- Inbound A2A gateway (Gemini Enterprise) ----------------------------------------------
A2AT_SAMPLE_GATEWAY_HOST=127.0.0.1
A2AT_SAMPLE_GATEWAY_PORT=8001
A2AT_SAMPLE_GATEWAY_SCENARIO=information
# Protocol the gateway uses toward the NMS: `a2a-t` (vendor negotiation) or `a2a` (standard).
A2AT_SAMPLE_GATEWAY_DOWNSTREAM_PROTOCOL=a2a-t
# Public URL written into the gateway AgentCard; Gemini Enterprise must be able to reach it.
A2AT_SAMPLE_GATEWAY_PUBLIC_URL=https://ran-client.example:8001
# Separate callback receiver of the gateway process (the UI keeps A2AT_SAMPLE_WEBHOOK_PORT).
A2AT_SAMPLE_GATEWAY_WEBHOOK_PORT=9001
# A2AT_SAMPLE_GATEWAY_TASK_DB=/absolute/path/to/gateway-task-status.sqlite3

# --- Authentication -----------------------------------------------------------------------
# Bearer token required by the Web UI API and the inbound gateway; empty keeps them open.
A2AT_SAMPLE_AUTH_TOKEN=<ui-and-gateway-token>
# Bearer token the client presents to the local A2A server; empty keeps it open.
A2AT_SAMPLE_SERVER_AUTH_TOKEN=<client-to-server-token>

# --- Client persistence -------------------------------------------------------------------
# A2AT_SAMPLE_CLIENT_DB=/absolute/path/to/client-state.sqlite3
# A2AT_SAMPLE_TASK_DB=/absolute/path/to/task-status.sqlite3
A2AT_SAMPLE_CLIENT_MEMORY_TURNS=6
A2AT_SAMPLE_ADK_SESSION_RETENTION_DAYS=14

# --- Tester judge (optional) --------------------------------------------------------------
# Independent decision-quality judge used by the tester appendix.
# A2AT_OSP_JUDGE_MODEL=<judge-model>
# A2AT_OSP_JUDGE_API_BASE=<judge-base-url>
# A2AT_OSP_JUDGE_API_KEY=<judge-key>

# --- Langfuse export (optional) -----------------------------------------------------------
# The OTLP exporter is best-effort; without both keys it is a no-op.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# A2AT_SAMPLE_LANGFUSE_ENABLED=1
# A2AT_SAMPLE_LANGFUSE_CAPTURE_CONTENT=1
# A2AT_SAMPLE_LANGFUSE_ENVIRONMENT=demo
