# Shared configuration of the `a2a-t-sample` case collection.
#
# The RAN energy-saving ADK sample reads this file when it runs from `a2a-t-sample/`; the sample
# also ships its own copy at `ran-energy-saving/env.example`. Copy either one to `.env`:
#
#   cp a2a-t-sample/env.example a2a-t-sample/.env
#
# The defaults below are a complete offline profile for the RAN energy-saving sample: no API key
# and no network access are required. Every key is read by `shared/config.py`, `run_demo.py`, or
# the A2A-T SDK itself; see `ran-energy-saving/README.md` §8 for the full reference.

# --- Model mode ---------------------------------------------------------------------------
A2AT_SAMPLE_MODEL_MODE=offline

# --- Process-level language ---------------------------------------------------------------
A2AT_LANGUAGE=en-US

# --- A2A server bind ----------------------------------------------------------------------
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8000

# --- Mock registry center -----------------------------------------------------------------
REGISTRY_CENTER_HOST=127.0.0.1
REGISTRY_CENTER_PORT=5001

# --- Service discovery --------------------------------------------------------------------
A2AT_SAMPLE_DISCOVERY=registry
A2AT_SAMPLE_DIRECT_SERVER_URL=http://127.0.0.1:8000

# --- Client event transport ---------------------------------------------------------------
A2AT_SAMPLE_TRANSPORT=sse
A2AT_SAMPLE_WEBHOOK_PORT=9000
A2AT_SAMPLE_WEBHOOK_TOKEN=demo-webhook-token
# Backstop: end a webhook phase when no push arrives for this many seconds. It follows the client
# HTTP budget so a webhook phase cannot end before the client gives up (default 300 = HTTP budget).
A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=300
# Real-NMS callback: the vendor NMS requires https and reaches the client through a gateway
# address, so register a public URL instead of the bind address. The TLS pair makes the embedded
# receiver serve https; AUTH_CREDENTIALS (`user:password`) is the Basic auth registered in the push
# config and the only credential the receiver accepts while set (otherwise it checks the push
# token). Keep the credential only in .env. See ran-energy-saving/env.example for details.
# A2AT_SAMPLE_WEBHOOK_PUBLIC_URL=https://<gateway>:9000/webhook
# A2AT_SAMPLE_WEBHOOK_TLS_CERT=Orange/server.cer
# A2AT_SAMPLE_WEBHOOK_TLS_KEY=Orange/server_key_nopass.pem
# A2AT_SAMPLE_WEBHOOK_AUTH_CREDENTIALS=<user>:<password>

# --- Timeout budgets (live fail-fast) -----------------------------------------------------
# Client HTTP budget of one A2A request; it must outlast the live server gate (several LLM calls
# before any event). The default 300s covers the 120s per-call budget across a gate plus ADK turns.
A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300
# Live LLM budget of one call (SDK structured call or ADK LiteLlm turn) and the SDK's protocol
# retry limit (1..10). Both values are written into the per-run SDK .env, overriding the source
# A2AT_LLM_* values. The OpenAI transport retries are disabled by the traced provider, so one call
# cannot silently become three attempts; raise the timeout further for slower endpoints.
A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120
A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1
# Migration: existing .env files that set A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=30 or
# A2AT_LLM_TIMEOUT_SECONDS=60 should be updated or removed; the new sample keys are
# A2AT_SAMPLE_HTTP_TIMEOUT_SECONDS=300, A2AT_SAMPLE_LLM_TIMEOUT_SECONDS=120 and
# A2AT_SAMPLE_LLM_MAX_ATTEMPTS=1.

# --- Web UI -------------------------------------------------------------------------------
# Default bind host/port of `run_demo.py --ui`; explicit `--ui-host` / `--ui-port` override them.
# Use 0.0.0.0 to expose the UI on all interfaces (trusted networks only: no authentication).
A2AT_SAMPLE_UI_HOST=127.0.0.1
A2AT_SAMPLE_UI_PORT=8080

# --- Run Explorer trace transport (local demo only) ---------------------------------------
# `run_demo.py --ui` sets both keys for the server process automatically: the server POSTs trace
# spans to the Web UI, which accepts them only with the matching per-run token. With neither key
# set (the CLI case) the server writes runs/<runId>/server-trace.jsonl under A2AT_SAMPLE_TRACE_DIR.
# Keep this transport on localhost only: spans carry model prompts, tool arguments and results.
# A2AT_SAMPLE_TRACE_URL=http://127.0.0.1:8080
# A2AT_SAMPLE_TRACE_TOKEN=<random-local-token>
# A2AT_SAMPLE_TRACE_DIR=runs

# --- OSS task persistence -----------------------------------------------------------------
# Absolute SQLite path of the server's A2A Task store. `run_demo.py` overwrites this with
# <sample>/runs/task-status.sqlite3, so the Web UI can show the persisted task table. Unset keeps
# the in-memory store.
# A2AT_SAMPLE_TASK_DB=/absolute/path/to/task-status.sqlite3

# --- Client persistence -------------------------------------------------------------------
# Absolute SQLite path of the client state (conversations, turns, runs, negotiation audit and
# task snapshots). The client and the RAN server use two separate databases.
# A2AT_SAMPLE_CLIENT_DB=/absolute/path/to/client-state.sqlite3
A2AT_SAMPLE_CLIENT_MEMORY_TURNS=6

# --- Inbound A2A gateway (optional, Gemini Enterprise path) -------------------------------
A2AT_SAMPLE_GATEWAY_HOST=127.0.0.1
A2AT_SAMPLE_GATEWAY_PORT=8001
A2AT_SAMPLE_GATEWAY_REGISTER=0
A2AT_SAMPLE_GATEWAY_SCENARIO=information

# --- LangGraph planner (server side, live mode) -------------------------------------------
# Defaults to the ADK endpoint/model above when unset.
# A2AT_SAMPLE_PLANNER_MODEL=mass/volcengine/deepseek-v4.1-flash
# A2AT_SAMPLE_PLANNER_API_BASE=http://127.0.0.1:31943/v1
# A2AT_SAMPLE_PLANNER_API_KEY=not-needed
A2AT_SAMPLE_PLANNER_TIMEOUT_SECONDS=120
A2AT_SAMPLE_PLANNER_MAX_STEPS=12

# --- ADK agent model (client only, live mode) ---------------------------------------------
ADK_MODEL_PROVIDER=litellm
ADK_MODEL_NAME=openai/mass/volcengine/deepseek-v4.1-flash
ADK_MODEL_API_BASE=http://127.0.0.1:31943/v1
ADK_MODEL_API_KEY=not-needed

# --- A2A-T SDK LLM (live mode) ------------------------------------------------------------
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=mass/volcengine/deepseek-v4.1-flash
A2AT_LLM_API_KEY=not-needed
A2AT_LLM_BASE_URL=http://127.0.0.1:31943/v1
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
# Source value only: the sample overrides it (see A2AT_SAMPLE_LLM_TIMEOUT_SECONDS / _MAX_ATTEMPTS).
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_DETAIL_LOG_ENABLED=false

# --- Sample debug logging -----------------------------------------------------------------
A2AT_SAMPLE_DEBUG=false

# --- Upstream compatibility keys ----------------------------------------------------------
# Kept from the upstream sample env. The RAN sample does not read the legacy scenario keys; the
# SDK prompt/LLM-history keys are harmless when the sample config does not use them.
A2AT_SAMPLE_SCENARIO=default
A2AT_SAMPLE_NEGOTIATION_KIND=information
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100
