# Registry center (mock HTTP service for AgentCard register/query)
REGISTRY_CENTER_HOST=127.0.0.1
REGISTRY_CENTER_PORT=5001

# Sample bind
A2AT_SAMPLE_HOST=127.0.0.1
A2AT_SAMPLE_PORT=8000
A2AT_SAMPLE_DEBUG=false

# ran-energy-saving scenario variant: "default" runs the existing flow, "negotiation" makes the
# client input miss the region param so the server opens an information negotiation
# (run_demo.py --scenario writes this key into the per-run .env)
A2AT_SAMPLE_SCENARIO=default

# ran-energy-saving negotiation kind selecting the client scenario input: "information"
# (missing region), "target" (100Mbps throughput beyond cell capability), "feasibility" (30%
# saving goal conflicting with 50Mbps throughput). "information" engages only together with
# A2AT_SAMPLE_SCENARIO=negotiation; "target"/"feasibility" engage without it. The kind only
# selects the scenario input; the
# server stays data-driven on the content-validation error code
# (run_demo.py --negotiation writes this key into the per-run .env)
A2AT_SAMPLE_NEGOTIATION_KIND=information

# ran-energy-saving generation channel of the negotiation propose/accept messages: "data"
# generates them from typed content (no extraction LLM call), "text" from a natural-language
# rendering plus one extraction LLM call
# (run_demo.py --channel writes this key into the per-run .env)
A2AT_SAMPLE_CHANNEL=data

# ran-energy-saving event transport: "sse" consumes the streamed response, "webhook" embeds the
# client-side webhook receiver and receives the task events as push-notification callbacks
# (run_demo.py --transport writes this key into the per-run .env)
A2AT_SAMPLE_TRANSPORT=sse

# ran-energy-saving webhook mode (used when A2AT_SAMPLE_TRANSPORT=webhook): the receiver bind
# port ("0" selects an OS-assigned ephemeral port), the push token the server must carry in the
# X-A2A-Notification-Token header (a mismatch answers 401), and the idle backstop timeout in
# seconds that ends the default scenario when no push arrives
# (run_demo.py --webhook-port writes the port key into the per-run .env)
A2AT_SAMPLE_WEBHOOK_PORT=9000
A2AT_SAMPLE_WEBHOOK_TOKEN=demo-webhook-token
A2AT_SAMPLE_WEBHOOK_IDLE_TIMEOUT=30

# Prompt runtime (1.0.0 SDK reads only from .env, not OS env)
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# LLM runtime (1.0.0 SDK: provider must be "openai"; backend set via base_url)
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100
# Whether to print the full LLM request and response payloads (no truncation). Defaults to
# false. WARNING: enabling this prints detailed LLM interaction content, which may expose
# sensitive information and consume large amounts of log space; use ONLY during project
# debugging and keep it disabled in production.
# Summary logs (timestamp, token usage, elapsed time) are recorded at DEBUG level whenever
# the dedicated logger a2a_t.llm.call is enabled for DEBUG; where the lines are printed is
# decided by the embedding application's logging framework.
A2AT_LLM_DETAIL_LOG_ENABLED=false

# Negotiation
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
